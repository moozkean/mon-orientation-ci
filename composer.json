{
    "name": "mon-orientation-ci/backend",
    "type": "project",
    "description": "Plateforme Nationale d'Orientation Académique Post-BAC pour la Côte d'Ivoire - API REST & Panel Admin",
    "keywords": ["orientation", "cote-d-ivoire", "baccalaureat", "universites", "mesrs", "bts"],
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.3",
        "laravel/framework": "^11.0 || ^12.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
